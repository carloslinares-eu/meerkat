/**
 * @file version.hpp
 * @brief Build-time version information, generated by CMake from version.hpp.in.
 */
#pragma once

#include <string_view>

namespace meerkat {

/// meerkat's version, from `project(VERSION)` in CMakeLists.txt.
inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

}  // namespace meerkat
